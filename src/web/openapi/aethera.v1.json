            }
          }
        },
        "security": [
          {
            "cookieAuth": [ ]
          },
          {
            "bearerAuth": [ ]
          }
        ],
        "x-required-scope": "read"
      }
    },
    "/api/v1/jobs/{id}/logs": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "Read a job's log, paged by sequence, or download it as text",
        "description": "JSON pages by default (`fromSequence`, `limit`). With `download=true` the whole log from `fromSequence` is streamed as `text/plain`.",
        "operationId": "getJobLogs",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "fromSequence",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int64"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "download",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated (auth.unauthenticated).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Role or token scope insufficient (auth.forbidden, auth.insufficient_scope).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error (internal.error).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookieAuth": [ ]
          },
          {
            "bearerAuth": [ ]
          }
        ],
        "x-required-scope": "read"
      }
    },
    "/api/v1/jobs/{id}/cancel": {
      "post": {
        "tags": [
          "Jobs"
        ],
        "summary": "Cancel a job",
        "description": "A queued job is cancelled immediately; a running job is asked to stop and ends cancelled within one heartbeat.",
        "operationId": "cancelJob",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated (auth.unauthenticated).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Role or token scope insufficient (auth.forbidden, auth.insufficient_scope).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error (internal.error).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookieAuth": [ ]
          },
          {
            "bearerAuth": [ ]
          }
        ],
        "x-required-scope": "deploy"
      }
    },
    "/api/v1/jobs/{id}/retry": {
      "post": {
        "tags": [
          "Jobs"
        ],
        "summary": "Retry a failed or cancelled job",
        "description": "Creates a new job linked to the original (`parentJobId`); the original stays as it is.",
        "operationId": "retryJob",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated (auth.unauthenticated).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Role or token scope insufficient (auth.forbidden, auth.insufficient_scope).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error (internal.error).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookieAuth": [ ]
          },
          {
            "bearerAuth": [ ]
          }
        ],
        "x-required-scope": "deploy"
      }
    }
  },
  "components": {
    "schemas": {
      "FieldError": {
        "required": [
          "code",
          "message"
        ],
        "type": "object",
        "properties": {
          "pointer": {
            "type": "string",
            "description": "JSON Pointer (RFC 6901) to the offending body member, e.g. /domains/0/host."
          },
          "parameter": {
            "type": "string",
            "description": "Name of the offending query or path parameter."
          },
          "code": {
            "type": "string",
            "description": "Short stable validator id: required, too_long, too_short, pattern, range, invalid_enum, not_unique, or a domain-specific code."
          },
          "message": {
            "type": "string"
          }
        },
        "description": "One field-level problem. Exactly one of pointer (JSON Pointer into the body) or parameter (query/path) is set."
      },
      "JobDto": {
        "required": [
          "id",
          "type",
          "status",
          "cancelRequested",
          "priority",
          "resource",
          "queuePosition",
          "attempt",
          "maxAttempts",
          "retryNo",
          "runAfter",
          "createdAt",
          "startedAt",
          "finishedAt",
          "parentJobId",
          "createdBy",
          "error",
          "result",
          "links"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "cancelRequested": {
            "type": "boolean"
          },
          "priority": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "resource": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JobResourceDto"
              }
            ]
          },
          "queuePosition": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "attempt": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "maxAttempts": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "retryNo": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "runAfter": {
            "format": "date-time"
          },
          "createdAt": {
            "format": "date-time"
          },
          "startedAt": {
            "format": "date-time"
          },
          "finishedAt": {
            "format": "date-time"
          },
          "parentJobId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "createdBy": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JobErrorDto"
              }
            ]
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonElement"
              }
            ]
          },
          "links": {
            "$ref": "#/components/schemas/JobLinksDto"
          }
        }
      },
      "JobErrorDto": {
        "required": [
          "code",
          "title",
          "detail",
          "failedStep",
          "retryable"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "failedStep": {
            "type": [
              "null",
              "string"
            ]
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "JobLinksDto": {
        "required": [
          "self",
          "logs"
        ],
        "type": "object",
        "properties": {
          "self": {
            "type": "string"
          },
          "logs": {
            "type": "string"
          }
        }
      },
      "JobResourceDto": {
        "required": [
          "type",
          "id"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "JobStatus": {
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "cancelled"
        ]
      },
      "JsonElement": { },
      "PageOfJobDto": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobDto"
            }
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProblemDetails": {
        "required": [
          "type",
          "title",
          "status",
          "code",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Always urn:aethera:problem:<code>."
          },
          "title": {
            "type": "string",
            "description": "Short fixed phrase per code. Do not parse."
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string",
            "description": "Occurrence-specific text for humans. Do not parse."
          },
          "instance": {
            "type": "string",
            "description": "The request path."
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable code, area.reason. Clients branch on this. Resource-specific codes (<resource>.not_found, <resource>.already_exists) are open-ended.",
            "x-known-codes": [
              "auth.forbidden",
              "auth.insufficient_scope",
              "auth.unauthenticated",
              "concurrency.conflict",
              "confirmation.required",
              "domain.rule_violation",
              "internal.error",
              "pagination.invalid_cursor",
              "precondition.failed",
              "rate_limited",
              "request.malformed",
              "request.method_not_allowed",
              "request.not_acceptable",
              "request.too_large",
              "request.unsupported_media_type",
              "resource.conflict",
              "route.not_found",
              "service.unavailable",
              "validation.failed",
              "validation.invalid_parameter"
            ]
          },
          "traceId": {
            "type": "string",
            "description": "The X-Request-Id of the failed request."
          }
        },
        "additionalProperties": { },
        "description": "RFC 9457 problem details."
      },
      "ValidationProblem": {
        "required": [
          "type",
          "title",
          "status",
          "code",
          "traceId",
          "errors"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Always urn:aethera:problem:<code>."
          },
          "title": {
            "type": "string",
            "description": "Short fixed phrase per code. Do not parse."
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string",
            "description": "Occurrence-specific text for humans. Do not parse."
          },
          "instance": {
            "type": "string",
            "description": "The request path."
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable code, area.reason. Clients branch on this. Resource-specific codes (<resource>.not_found, <resource>.already_exists) are open-ended.",
            "x-known-codes": [
              "auth.forbidden",
              "auth.insufficient_scope",
              "auth.unauthenticated",
              "concurrency.conflict",
              "confirmation.required",
              "domain.rule_violation",
              "internal.error",
              "pagination.invalid_cursor",
              "precondition.failed",
              "rate_limited",
              "request.malformed",
              "request.method_not_allowed",
              "request.not_acceptable",
              "request.too_large",
              "request.unsupported_media_type",
              "resource.conflict",
              "route.not_found",
              "service.unavailable",
              "validation.failed",
              "validation.invalid_parameter"
            ]
          },
          "traceId": {
            "type": "string",
            "description": "The X-Request-Id of the failed request."
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        },
        "additionalProperties": { },
        "description": "RFC 9457 problem with field-level errors (422, and 400 for invalid parameters)."
      }
    },
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "description": "Browser session. Unsafe methods must also send the X-CSRF-Token header (GET /auth/csrf).",
        "name": "__Host-aethera_session",
        "in": "cookie"
      },
      "bearerAuth": {
        "type": "http",
        "description": "API token: Authorization: Bearer aeth_... Its scopes are listed per operation as x-required-scope.",
        "scheme": "bearer",
        "bearerFormat": "aeth_<token>"
      }
    }
  },
  "tags": [
    {
      "name": "Jobs"
    }
  ]
}