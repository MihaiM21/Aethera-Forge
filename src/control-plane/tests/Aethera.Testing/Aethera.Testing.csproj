<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared test support for every test project that talks to the API: AetheraApiFactory, TestAuthHandler, seeding helpers and the
    PostgreSQL fixture. Kept as its own library (not inside Aethera.Api.Tests) because test projects cannot reference each other
    cleanly and later work packages add their own test projects/classes that need the same factory.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aethera.Api\Aethera.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
