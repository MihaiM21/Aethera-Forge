# Master. Copy to deploy/.env
AETHERA_PUBLIC_HOST=localhost     # hostname or IP that slave servers use to reach this machine
AETHERA_DB_PASSWORD=change-me
#AETHERA_HTTP_PORT=8080
#AETHERA_GRPC_PORT=9443
#AETHERA_MASTER_KEY=              # base64 of 32 bytes (openssl rand -base64 32); unset = auto-generated in the aethera_data volume

# The master machine itself needs no settings here: its agent container connects as the "local" server once the owner has registered
# (AETHERA_AUTO_LOCAL_SERVER=false turns that off; Servers > "Use this machine" then does it on demand).
# For a different machine, create the server in the UI (Servers > Add server) and run the install command it prints there.
